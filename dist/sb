    case "$p" in
        reality) port=443;; hy2) port=8443;; tuic) port=443;;
        anytls) port=8443;; trojan) port=443;; ss2022) port=8388;;
    esac
    port=$(tui_input "添加节点" "监听端口" "$port") || return 0
    remark=$(tui_input "添加节点" "备注（可空）" "") || remark=""
    case "$p" in
