#!/usr/bin/env bash
# sb-mgr - SingBox-YUY 主入口：CLI 参数解析 / 无参数进 TUI
set -euo pipefail

MGR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$MGR_DIR/lib"

# shellcheck source=lib/common.sh
. "$LIB/common.sh"
. "$LIB/envcheck.sh"
. "$LIB/install.sh"
. "$LIB/inbound.sh"
. "$LIB/warp.sh"
. "$LIB/route.sh"
. "$LIB/export.sh"
. "$LIB/sub.sh"
. "$LIB/crypto.sh"
. "$LIB/tui.sh"

usage() {
    cat <<EOF
SingBox-YUY v$SB_VERSION - 现代化 sing-box 一键安装/运维工具

用法：
  sb-mgr install [--proto hy2|reality|tuic|anytls|trojan|ss] [--port N] [--domain D] [--sni S] [--yes]
  sb-mgr uninstall [--yes] [--purge-binary]
  sb-mgr envcheck | add --proto P [...] | list | del <id> | link <id> [--qr]
  sb-mgr node-modify --id <id> [--remark R] [--port P] [--sni S] [--password PW] [--uuid U] [--regen-key] [--ports 起始:结束]
  sb-mgr warp | route-unlock | route-lock
  sb-mgr relay-add (--link URI | --from-node <id> [--host H])
  sb-mgr relay-route --tag <tag> --geosite <g1,g2> | sb-mgr relay-del --tag <tag> | sb-mgr relay-list
  sb-mgr export --format uri|singbox|clash [--out FILE] [--id ID]
  sb-mgr sub [start|stop|restart|regen] | sb-mgr sub-regen
  sb-mgr node-export --out FILE --password PW | sb-mgr node-import --in FILE --password PW [--yes]
  sb-mgr check | update | set-host <h> | tui | version | help
  sb-mgr self-update              # 仅单文件版：从 $SB_DIST_URL 更新自身

无参数时进入 TUI 交互菜单。
EOF
}

cmd_add() { # add --proto P [协议参数...]
    ensure_etc
    local proto=""
    local rest=()
    while [ $# -gt 0 ]; do case "$1" in
        --proto) proto="$2"; shift 2;;
        *) rest+=("$1"); shift;;
    esac; done
    case "$proto" in
        reality) add_reality "${rest[@]}" ;;
        hy2)     add_hy2 "${rest[@]}" ;;
        tuic)    add_tuic "${rest[@]}" ;;
        anytls)  add_anytls "${rest[@]}" ;;
        trojan)  add_trojan "${rest[@]}" ;;
        ss|ss2022) add_ss2022 "${rest[@]}" ;;
        *) die "未知协议：$proto（reality|hy2|tuic|anytls|trojan|ss2022）" ;;
    esac
}

cmd_install() { # install [--proto P] [--port N] [--domain D] [--sni S] [--yes]
    local proto="" port="" domain="" sni="" yes=0
    while [ $# -gt 0 ]; do case "$1" in
        --proto)  proto="$2"; shift 2;;
        --port)   port="$2"; shift 2;;
        --domain) domain="$2"; shift 2;;
        --sni)    sni="$2"; shift 2;;
        --yes)    yes=1; SB_MGR_YES=1; export SB_MGR_YES; shift;;
        *) die "install 未知参数：$1";;
    esac; done
    local im_args=()
    [ "$yes" = "1" ] && im_args+=(--yes)
    install_main "${im_args[@]}"
    envcheck_main || true
    if [ -n "$proto" ]; then
        local args=(--proto "$proto" --yes)
        [ -n "$port" ] && args+=(--port "$port")
        [ -n "$domain" ] && args+=(--domain "$domain")
        [ -n "$sni" ] && args+=(--sni "$sni")
        cmd_add "${args[@]}"
    fi
}

cmd_self_update() {
    # 仅单文件 bundled 模式可用；源码模式请用 git pull
    if [ "${SB_BUNDLED:-}" != "1" ]; then
        die "self-update 仅单文件版（sb）可用；源码版请用 git pull 更新"
    fi
    local self="${SB_SELF:-}"
    [ -n "$self" ] && [ -f "$self" ] || die "无法定位自身文件，拒绝更新"
    grep -q '^SB_DIST_VERSION=' "$self" 2>/dev/null \
        || die "目标不是 SingBox-YUY 单文件（$self），拒绝更新"
    local old_ver="$SB_DIST_VERSION" new_ver tmp
    tmp="$(mktemp)" || die "mktemp 失败"
    # raw.githubusercontent.com 有约 5 分钟 CDN 缓存；http(s) 下载加时间戳穿透，
    # 避免刚推送完就 self-update 时拿到旧文件。file:// 等其他协议不受影响。
    local url="$SB_DIST_URL"
    case "$url" in
        http*://*)
            case "$url" in
                *\?*) url="${url}&_t=$(date +%s)" ;;
                *)      url="${url}?_t=$(date +%s)" ;;
            esac
            ;;
    esac
    log_info "下载新版：$SB_DIST_URL"
    if ! curl -fsSL --retry 2 -m 120 "$url" -o "$tmp"; then
        rm -f "$tmp"; die "下载失败，请检查网络或 SB_DIST_URL"
    fi
    grep -q '^SB_DIST_VERSION=' "$tmp" \
        || { rm -f "$tmp"; die "下载的文件不是有效的 SingBox-YUY 单文件"; }
    new_ver="$(sed -n 's/^SB_DIST_VERSION="\(.*\)"$/\1/p' "$tmp" | head -1)"
    [ -n "$new_ver" ] || new_ver="未知"
    # 按内容校验和判断是否需要更新：版本号相同但内容不同（同版本热修复）也要更新；
    # sha256sum 不可用时保守地执行更新（宁可多下一次，不跳过可能的修复）
    local old_sum new_sum
    old_sum="$(sha256sum "$self" 2>/dev/null | awk '{print $1}')"
    new_sum="$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')"
    if [ -n "$old_sum" ] && [ "$old_sum" = "$new_sum" ]; then
        rm -f "$tmp"; log_ok "已是最新版（v$old_ver），无需更新"; return 0
    fi
    cat "$tmp" > "$self" || { rm -f "$tmp"; die "写入 $self 失败"; }
    rm -f "$tmp"
    chmod +x "$self"
    # 删除版本标记，下次运行时重新释放 payload
    rm -f "${SB_HOME:?SB_HOME 未设置}/.dist_version"
    if [ "$new_ver" = "$old_ver" ]; then
        log_ok "已更新到 v$new_ver（同版本热修复，内容已变化，下次运行自动释放新 payload）"
    else
        log_ok "已更新：v$old_ver -> v$new_ver（下次运行时自动释放新 payload）"
    fi
}

cmd_check() {
    ensure_etc
    [ -x "$SB_BIN" ] || die "未找到 sing-box：$SB_BIN（先 sb-mgr install）"
    python3 "$(builder_py)" || die "配置渲染失败"
    "$SB_BIN" check -c "$CONFIG_JSON" && log_ok "配置校验通过"
}

cmd_set_host() {
    ensure_etc
    [ -n "${1:-}" ] || die "用法：sb-mgr set-host <IP或域名>"
    json_set "$SETTINGS_JSON" --arg h "$1" '.host = $h'
    log_ok "订阅/链接 HOST 已设为：$1"
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        ""|tui)            tui_main ;;
        help|--help|-h)    usage ;;
        version|--version) echo "SingBox-YUY v$SB_VERSION" ;;
        install)  shift; cmd_install "$@" ;;
        update)   update_main ;;
        uninstall) shift; uninstall_main "$@" ;;
        envcheck) envcheck_main ;;
        add)      shift; cmd_add "$@" ;;
        list)     ensure_etc; list_inbounds ;;
        del)      ensure_etc; del_inbound "${2:-}" ;;
        node-modify) shift; node_modify "$@" ;;
        link)     shift; link_main "$@" ;;
        warp)     warp_main ;;
        route-unlock) route_unlock_main ;;
        route-lock)   route_lock_main ;;
        relay-add)   shift; relay_add_main "$@" ;;
        relay-route) shift; relay_route_main "$@" ;;
        relay-del)   shift; relay_del_main "$@" ;;
        relay-list)  relay_list_main ;;
        export)   shift; export_main "$@" ;;
        sub)      shift; sub_main "$@" ;;
        sub-regen) sub_regen_main ;;
        node-export) shift; crypto_export_main "$@" ;;
        node-import) shift; crypto_import_main "$@" ;;
        check)    cmd_check ;;
        self-update) cmd_self_update ;;
        set-host) shift; cmd_set_host "$@" ;;
        *) log_err "未知命令：$cmd"; usage; exit 2 ;;
    esac
}

main "$@"
